  "end": 7.66,
  "text": "Vocês escolheram o projeto. Então o Lucas levou o Corsa pro seu Jorge."
 },
 {
  "who": "narr",
  "start": 7.81,
  "end": 11.66,
  "text": "Mecânico do bairro há quarenta anos. E amigo do avô."
 },
 {
  "who": "jorge",
  "start": 11.81,
  "end": 14.35,
  "text": "Esse escapamento tá podre, moleque."
 },
 {
  "who": "jorge",
  "start": 15.3,
  "end": 19.09,
  "text": "Escape novo, instalado: seiscentos e cinquenta."
 },
 {
  "who": "narr",
  "start": 19.4,
  "end": 20.87,
  "text": "O Lucas tinha trezentos."
 },
 {
  "who": "narr",
  "start": 23.6,
