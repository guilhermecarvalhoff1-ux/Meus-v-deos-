[
 {
  "start": 0.062,
  "end": 0.75,
  "text": "ESSE PLANETA"
 },
 {
  "start": 0.75,
  "end": 1.663,
  "text": "TERMINA O ANO"
 },
 {
  "start": 1.725,
  "end": 3.1,
  "text": "ANTES DE DAR UMA VOLTA"
 },
 {
  "start": 3.112,
  "end": 4.35,
  "text": "EM TORNO DE SI MESMO."
 },
 {
  "start": 4.737,
  "end": 5.15,
  "text": "QUE PORRA"
 },
 {
  "start": 5.15,
  "end": 6.487,
  "text": "DE CALENDÁRIO É ESSE?"
 },
 {
  "start": 6.937,
  "end": 8.224,
  "text": "É VÊNUS, CARA."
 },
 {
  "start": 8.637,
  "end": 10.137,
  "text": "PRA DAR UMA VOLTA NO SOL,"
 },
 {
  "start": 10.587,
  "end": 12.519,
  "text": "ELE LEVA UNS 225"
 },
 {
  "start": 12.519,
  "end": 14.499,
  "text": "DIAS TERRESTRES."
 },
 {
  "start": 14.874,
  "end": 16.224,
  "text": "ATÉ AÍ, TRANQUILO."
 },
 {
  "start": 16.654,
  "end": 17.992,
  "text": "AGORA, PRA GIRAR"
 },
 {
  "start": 17.992,
  "end": 18.804,
  "text": "EM TORNO DE SI?"
 },
 {
  "start": 19.505,
  "end": 20.83,
  "text": "243."
 },
 {
  "start": 20.855,
  "end": 21.755,
  "text": "DUZENTOS E QUARENTA"
 },
 {
  "start": 21.755,
  "end": 23.08,
  "text": "E TRÊS, CARALHO."
 },
 {
  "start": 23.455,
  "end": 24.505,
  "text": "O ANO ACABA"
 },
 {
  "start": 24.517,
  "end": 26.055,
  "text": "E O DESGRAÇADO AINDA TÁ"
 },
 {
  "start": 26.055,
  "end": 27.03,
  "text": "TERMINANDO O GIRO."
 },
 {
  "start": 27.43,
  "end": 28.605,
  "text": "SEM PRESSA NENHUMA."
 },
 {
  "start": 29.034,
  "end": 30.497,
  "text": "SÓ NÃO MISTURA AS COISAS,"
 },
 {
  "start": 30.809,
  "end": 32.172,
  "text": "QUE AÍ VIRA BAGUNÇA:"
 },
 {
  "start": 32.659,
  "end": 33.659,
  "text": "DE UM NASCER DO SOL"
 },
 {
  "start": 33.659,
  "end": 34.247,
  "text": "AO PRÓXIMO,"
 },
 {
  "start": 34.622,
  "end": 36.459,
  "text": "SÃO UNS 117 DIAS."
 },
 {
  "start": 36.859,
  "end": 37.697,
  "text": "É OUTRA CONTA."
 },
 {
  "start": 38.14,
  "end": 38.89,
  "text": "NOX ACHOU"
 },
 {
  "start": 38.902,
  "end": 39.79,
  "text": "ESSE CALENDÁRIO"
 },
 {
  "start": 39.79,
  "end": 41.077,
  "text": "UMA BAGUNÇA DA PORRA."
 },
 {
  "start": 41.806,
  "end": 42.443,
  "text": "MAS PELO MENOS"
 },
 {
  "start": 42.456,
  "end": 43.331,
  "text": "A EXPLICAÇÃO"
 },
 {
  "start": 43.343,
  "end": 43.943,
  "text": "TÁ EM DIA."
 },
 {
  "start": 44.634,
  "end": 46.246,
  "text": "ACHOU MAIS ALGUMA MERDA"
 },
 {
  "start": 46.259,
  "end": 47.459,
  "text": "SEM SENTIDO POR AÍ?"
 },
 {
  "start": 47.834,
  "end": 48.934,
  "text": "MANDA NOS COMENTÁRIOS"
 },
 {
  "start": 48.934,
  "end": 50.096,
  "text": "QUE NOX EXPLICA."
 }
]