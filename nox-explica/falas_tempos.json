[
 {
  "start": 0.062,
  "end": 0.75,
  "text": "ESSE PLANETA"
 },
 {
  "start": 0.75,
  "end": 1.663,
  "text": "TERMINA O ANO"
 },
 {
  "start": 1.725,
  "end": 3.1,
  "text": "ANTES DE DAR UMA VOLTA"
 },
 {
  "start": 3.112,
  "end": 4.35,
  "text": "EM TORNO DE SI MESMO."
 },
 {
  "start": 4.737,
  "end": 5.15,
  "text": "QUE PORRA"
 },
 {
  "start": 5.15,
  "end": 6.487,
  "text": "DE CALENDÁRIO É ESSE?"
 },
 {
  "start": 7.037,
  "end": 8.324,
  "text": "É VÊNUS, CARA."
 },
 {
  "start": 8.737,
  "end": 10.237,
  "text": "PRA DAR UMA VOLTA NO SOL,"
 },
 {
  "start": 10.687,
  "end": 12.619,
  "text": "ELE LEVA UNS 225"
 },
 {
  "start": 12.619,
  "end": 14.599,
  "text": "DIAS TERRESTRES."
 },
 {
  "start": 14.974,
  "end": 16.324,
  "text": "ATÉ AÍ, TRANQUILO."
 },
 {
  "start": 16.854,
  "end": 18.192,
  "text": "AGORA, PRA GIRAR"
 },
 {
  "start": 18.192,
  "end": 19.004,
  "text": "EM TORNO DE SI?"
 },
 {
  "start": 19.855,
  "end": 21.18,
  "text": "243."
 },
 {
  "start": 21.205,
  "end": 22.105,
  "text": "DUZENTOS E QUARENTA"
 },
 {
  "start": 22.105,
  "end": 23.43,
  "text": "E TRÊS, CARALHO."
 },
 {
  "start": 23.805,
  "end": 24.855,
  "text": "O ANO ACABA"
 },
 {
  "start": 24.867,
  "end": 26.405,
  "text": "E O DESGRAÇADO AINDA TÁ"
 },
 {
  "start": 26.405,
  "end": 27.38,
  "text": "TERMINANDO O GIRO."
 },
 {
  "start": 27.78,
  "end": 28.955,
  "text": "SEM PRESSA NENHUMA."
 },
 {
  "start": 29.484,
  "end": 30.947,
  "text": "SÓ NÃO MISTURA AS COISAS,"
 },
 {
  "start": 31.259,
  "end": 32.622,
  "text": "QUE AÍ VIRA BAGUNÇA:"
 },
 {
  "start": 33.109,
  "end": 34.109,
  "text": "DE UM NASCER DO SOL"
 },
 {
  "start": 34.109,
  "end": 34.697,
  "text": "AO PRÓXIMO,"
 },
 {
  "start": 35.072,
  "end": 36.909,
  "text": "SÃO UNS 117 DIAS."
 },
 {
  "start": 37.309,
  "end": 38.147,
  "text": "É OUTRA CONTA."
 },
 {
  "start": 38.69,
  "end": 39.44,
  "text": "NOX ACHOU"
 },
 {
  "start": 39.452,
  "end": 40.34,
  "text": "ESSE CALENDÁRIO"
 },
 {
  "start": 40.34,
  "end": 41.627,
  "text": "UMA BAGUNÇA DA PORRA."
 },
 {
  "start": 42.506,
  "end": 43.143,
  "text": "MAS PELO MENOS"
 },
 {
  "start": 43.156,
  "end": 44.031,
  "text": "A EXPLICAÇÃO"
 },
 {
  "start": 44.043,
  "end": 44.643,
  "text": "TÁ EM DIA."
 },
 {
  "start": 45.484,
  "end": 47.096,
  "text": "ACHOU MAIS ALGUMA MERDA"
 },
 {
  "start": 47.109,
  "end": 48.309,
  "text": "SEM SENTIDO POR AÍ?"
 },
 {
  "start": 48.684,
  "end": 49.784,
  "text": "MANDA NOS COMENTÁRIOS"
 },
 {
  "start": 49.784,
  "end": 50.946,
  "text": "QUE NOX EXPLICA."
 }
