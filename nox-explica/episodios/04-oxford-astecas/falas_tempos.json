  "text": "A UNIVERSIDADE"
 },
 {
  "start": 1.087,
  "end": 2.05,
  "text": "DE OXFORD"
 },
 {
  "start": 2.212,
  "end": 3.1,
  "text": "É MAIS VELHA"
 },
 {
  "start": 3.112,
  "end": 4.263,
  "text": "QUE O IMPÉRIO ASTECA."
 },
 {
  "start": 4.662,
  "end": 5.088,
  "text": "SÉRIO."
 },
 {
  "start": 5.487,
  "end": 6.375,
  "text": "QUE PORRA É ESSA?"
 },
 {
  "start": 6.796,
  "end": 7.658,
  "text": "EM OXFORD,"
 },
 {
  "start": 8.083,
  "end": 8.746,
  "text": "JÁ TINHA AULA"
 },
 {
  "start": 8.746,
  "end": 10.883,
  "text": "POR VOLTA DE 1096."
 },
 {
  "start": 11.246,
  "end": 12.708,
  "text": "A CAPITAL DOS ASTECAS,"
 },
 {
  "start": 13.096,
  "end": 13.858,
  "text": "TENOCHTITLAN,"
 },
 {
  "start": 14.296,
  "end": 15.146,
  "text": "SÓ FOI FUNDADA"
 },
 {
  "start": 15.158,
  "end": 16.746,
  "text": "EM 1325."
 },
 {
  "start": 17.121,
  "end": 18.183,
  "text": "MAIS DE DOIS SÉCULOS"
 },
 {
  "start": 18.196,
  "end": 19.471,
  "text": "DEPOIS, CARALHO."
 },
 {
  "start": 19.903,
  "end": 20.991,
  "text": "E O IMPÉRIO MESMO"
 },
 {
  "start": 20.991,
  "end": 23.341,
  "text": "SÓ NASCEU EM 1428"
 },
 {
  "start": 23.353,
  "end": 25.441,
  "text": "E CAIU EM 1521,"
 },
 {
  "start": 25.928,
  "end": 26.928,
  "text": "COM OS ESPANHÓIS."
 },
 {
  "start": 27.303,
  "end": 28.066,
  "text": "DUROU MENOS"
 },
 {
  "start": 28.078,
  "end": 29.053,
  "text": "DE CEM ANOS."
 },
 {
  "start": 29.453,
  "end": 30.203,
  "text": "E OXFORD?"
 },
 {
  "start": 30.566,
  "end": 31.203,
  "text": "DANDO AULA"
 },
 {
  "start": 31.216,
  "end": 31.878,
  "text": "ATÉ HOJE."
 },
 {
  "start": 32.312,
  "end": 33.349,
  "text": "SÓ NÃO CONFUNDE:"
 },
 {
  "start": 33.824,
  "end": 35.049,
  "text": "ASTECA NÃO É MAIA."
 },
 {
  "start": 35.424,
  "end": 36.174,
  "text": "OS MAIAS SÃO"
 },
 {
  "start": 36.174,
  "end": 37.349,
  "text": "BEM MAIS ANTIGOS,"
 },
 {
  "start": 37.712,
  "end": 38.849,
  "text": "COM CIDADES SÉCULOS"
 },
 {
  "start": 38.862,
  "end": 40.262,
  "text": "ANTES DE OXFORD."
 },
 {
  "start": 40.637,
  "end": 42.649,
  "text": "E OXFORD NEM É"
 },
 {
  "start": 42.662,
  "end": 43.574,
  "text": "A MAIS VELHA:"
 },
 {
  "start": 43.924,
  "end": 45.487,
  "text": "BOLONHA, NA ITÁLIA,"
 },
 {
  "start": 45.862,
  "end": 47.124,
  "text": "É DE 1088."
 },
 {
  "start": 47.552,
  "end": 48.352,
  "text": "NOX ACHA QUE"
 },
 {
  "start": 48.352,
  "end": 49.214,
  "text": "A GENTE IMAGINA"
 },
 {
  "start": 49.227,
  "end": 50.152,
  "text": "A HISTÓRIA EM FILA,"
 },
 {
  "start": 50.602,
  "end": 51.702,
  "text": "MAS É TUDO MISTURADO."
 },
 {
  "start": 52.383,
  "end": 53.545,
  "text": "ACHOU MAIS ALGUMA"
 },
 {
  "start": 53.545,
  "end": 54.808,
  "text": "MERDA SEM SENTIDO"
 },
 {
  "start": 54.808,
  "end": 55.208,
  "text": "POR AÍ?"
 },
 {
  "start": 55.583,
  "end": 56.683,
  "text": "MANDA NOS COMENTÁRIOS"
 },
 {
  "start": 56.683,
  "end": 57.845,
  "text": "QUE NOX EXPLICA."
 }
