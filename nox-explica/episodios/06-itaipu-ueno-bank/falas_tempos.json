[
 {
  "start": 0.075,
  "end": 0.675,
  "text": "ITAIPU,"
 },
 {
  "start": 1.175,
  "end": 2.25,
  "text": "A USINA DO BRASIL"
 },
 {
  "start": 2.263,
  "end": 3.062,
  "text": "COM O PARAGUAI,"
 },
 {
  "start": 3.513,
  "end": 4.35,
  "text": "DEIXOU QUASE"
 },
 {
  "start": 4.35,
  "end": 5.388,
  "text": "UM BILHÃO DE REAIS..."
 },
 {
  "start": 6.058,
  "end": 7.121,
  "text": "NUM BANCO DIGITAL"
 },
 {
  "start": 7.133,
  "end": 8.208,
  "text": "DE UM ANO E POUCO."
 },
 {
  "start": 8.621,
  "end": 9.008,
  "text": "PORRA."
 },
 {
  "start": 9.442,
  "end": 10.579,
  "text": "O BANCO FOI APROVADO"
 },
 {
  "start": 10.579,
  "end": 11.442,
  "text": "EM DOZE DIAS,"
 },
 {
  "start": 11.692,
  "end": 12.854,
  "text": "PRO LADO PARAGUAIO."
 },
 {
  "start": 13.242,
  "end": 14.267,
  "text": "E A REGRA INTERNA,"
 },
 {
  "start": 14.642,
  "end": 15.579,
  "text": "SEGUNDO A IMPRENSA,"
 },
 {
  "start": 15.867,
  "end": 17.054,
  "text": "PEDIA CINCO ANOS"
 },
 {
  "start": 17.067,
  "end": 17.679,
  "text": "DE MERCADO."
 },
 {
  "start": 18.114,
  "end": 19.439,
  "text": "AÍ O BANCO CENTRAL"
 },
 {
  "start": 19.439,
  "end": 20.126,
  "text": "DO PARAGUAI"
 },
 {
  "start": 20.139,
  "end": 21.276,
  "text": "INTERVEIO NO BANCO."
 },
 {
  "start": 21.651,
  "end": 22.951,
  "text": "MAIS DE CENTO E SESSENTA"
 },
 {
  "start": 22.951,
  "end": 23.951,
  "text": "MILHÕES DE DÓLARES"
 },
 {
  "start": 23.964,
  "end": 24.614,
  "text": "TRAVADOS,"
 },
 {
  "start": 24.826,
  "end": 25.326,
  "text": "CARALHO."
 },
 {
  "start": 25.714,
  "end": 27.026,
  "text": "E O DIRETOR PARAGUAIO"
 },
 {
  "start": 27.314,
  "end": 28.326,
  "text": "DA USINA CAIU."
 },
 {
  "start": 28.758,
  "end": 29.808,
  "text": "SÓ NÃO CONFUNDE:"
 },
 {
  "start": 30.208,
  "end": 31.921,
  "text": "O LADO BRASILEIRO DIZ"
 },
 {
  "start": 31.921,
  "end": 32.983,
  "text": "QUE NUNCA BOTOU"
 },
 {
  "start": 32.996,
  "end": 33.658,
  "text": "DINHEIRO LÁ."
 },
 {
  "start": 34.033,
  "end": 35.246,
  "text": "E O DIRETOR QUE SAIU"
 },
 {
  "start": 35.258,
  "end": 36.746,
  "text": "NEGA TER QUEBRADO REGRA."
 },
 {
  "start": 37.146,
  "end": 38.108,
  "text": "TÁ SENDO APURADO."
 },
 {
  "start": 38.528,
  "end": 39.453,
  "text": "NOX QUER SABER"
 },
 {
  "start": 39.453,
  "end": 40.903,
  "text": "QUE MERDA DE CONFIANÇA"
 },
 {
  "start": 40.978,
  "end": 41.39,
  "text": "É ESSA."
 },
 {
  "start": 42.095,
  "end": 42.957,
  "text": "TEM OUTRA TRETA"
 },
 {
  "start": 42.97,
  "end": 44.382,
  "text": "QUE VOCÊ QUER ENTENDER?"
 },
 {
  "start": 44.77,
  "end": 45.882,
  "text": "MANDA NOS COMENTÁRIOS"
 },
 {
  "start": 45.882,
  "end": 47.132,
  "text": "QUE NOX EXPLICA."
 }
]